; The drawings of the game: cards and fonts, made with raylib shapes. It is
; not attached to balatro-gui because it uses the private balatro libraries;
; (optional) lets the terminal's build skip it when raylib is not installed.

(library
 (name balatro_art)
 (optional)
 (libraries balatro balatro_text raylib ctypes))

(rule
 (target font_data.ml)
 (deps ../assets/DejaVuSans.ttf)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../embed/embed.exe} %{deps}))))
