; The window. It needs raylib, which only the balatro-gui package depends
; on: without raylib, build with --only-packages balatro.

(executable
 (public_name balatro-gui)
 (name main)
 (package balatro-gui)
 (libraries balatro balatro_text balatro_cli balatro_gui raylib ctypes))

(rule
 (target font_data.ml)
 (deps ../../gui/assets/DejaVuSans.ttf)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../../gui/embed/embed.exe} %{deps}))))
