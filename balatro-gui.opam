# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A graphical interface for the Balatro model, made with raylib"
description:
  "A window to play the Balatro model with the mouse, built on the raylib bindings."
maintainer: ["Aline <line.asramos@gmail.com>"]
authors: ["Aline <line.asramos@gmail.com>"]
tags: ["balatro" "card-game" "poker" "raylib"]
homepage: "https://github.com/alinespereira/balatro"
bug-reports: "https://github.com/alinespereira/balatro/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml"
  "balatro" {= version}
  "raylib"
  "ctypes"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/alinespereira/balatro.git"
x-maintenance-intent: ["(latest)"]
